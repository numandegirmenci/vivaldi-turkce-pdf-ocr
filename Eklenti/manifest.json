{
  "manifest_version": 3,
  "name": "Türkçe PDF OCR (Chromium)",
  "version": "0.6.13",
  "description": "Türkçe PDF OCR, el yazısı/kaşe bölge inceleme ve isteğe bağlı yerel el yazısı modeli; Outlook, OneDrive, WhatsApp ekleri.",
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "alarms",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PDF OCR",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
