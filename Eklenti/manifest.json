{
  "manifest_version": 3,
  "name": "Türkçe PDF OCR (Beta)",
  "version": "0.1.1",
  "description": "PDF belgelerini tarayıcıda açıp Türkçe OCR ile seçilebilir metne dönüştürür. Yerel işlem.",
  "permissions": [
    "tabs",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PDF OCR",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
